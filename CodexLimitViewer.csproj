<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>CodexLimitViewer</AssemblyName><Product>Codex Limit Viewer</Product><Title>Codex Limit Viewer</Title><AssemblyTitle>Codex Limit Viewer</AssemblyTitle><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><Version>1.2.0</Version><Description>Codex Limit Viewer</Description><Company>hinatamaxxx</Company><Authors>hinatamaxxx</Authors><Copyright>Copyright (c) hinatamaxxx</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="installer/bin/**;installer/obj/**" />
    <EmbeddedResource Include="English.json" LogicalName="CodexLimitViewer.English.json" />
    <EmbeddedResource Include="ClaudeCodeStatusLine.ps1" LogicalName="CodexLimitViewer.ClaudeCodeStatusLine.ps1" />
    <EmbeddedResource Include="app.ico" LogicalName="CodexLimitViewerSetup.App.ico" />
    <!-- Documents and scripts the setup installs beside the exe; made by tools/BuildRelease.ps1. -->
    <EmbeddedResource Include="installer/payload.zip" LogicalName="CodexLimitViewerSetup.Payload.zip" Condition="Exists('installer/payload.zip')" />
  </ItemGroup>
</Project>
