<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the exe needs no bundled runtime and stays a few megabytes. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AssemblyName>UsageLimitViewer</AssemblyName><Product>Usage Limit Viewer</Product><Title>Usage Limit Viewer</Title><AssemblyTitle>Usage Limit Viewer</AssemblyTitle><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><Version>2.0.1</Version><Description>Usage Limit Viewer</Description><Company>hinatamaxxx</Company><Authors>hinatamaxxx</Authors><Copyright>Copyright (c) hinatamaxxx</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="installer/bin/**;installer/obj/**" />
    <EmbeddedResource Include="English.json" LogicalName="UsageLimitViewer.English.json" />
    <EmbeddedResource Include="ClaudeCodeStatusLine.ps1" LogicalName="UsageLimitViewer.ClaudeCodeStatusLine.ps1" />
    <EmbeddedResource Include="app.ico" LogicalName="UsageLimitViewerSetup.App.ico" />
    <!-- Documents and scripts the setup installs beside the exe; made by tools/BuildRelease.ps1. -->
    <EmbeddedResource Include="installer/payload.zip" LogicalName="UsageLimitViewerSetup.Payload.zip" Condition="Exists('installer/payload.zip')" />
  </ItemGroup>
  <!-- Keep one exe: library DLLs from NuGet are embedded and loaded by EmbeddedAssemblies instead of being copied beside it. -->
  <Target Name="EmbedLibraries" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>lib.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
</Project>
